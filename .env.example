# ── Base de données ─────────────────────────────────────────────────────────
# Prod/preview : Neon (Vercel Marketplace → Storage → Neon), connection string POOLED.
#   → driver HTTP serverless sélectionné automatiquement (hôte *.neon.tech)
# Local : n'importe quel Postgres (Docker…) → driver node-postgres.
DATABASE_URL="postgresql://postgres@localhost:5432/wedding"

# ── Back-office protocole ───────────────────────────────────────────────────
# Mot de passe partagé de l'équipe protocole (12 caractères minimum).
ADMIN_PASSWORD="change-me-to-a-long-passphrase"
# openssl rand -base64 32
SESSION_SECRET="replace-with-32+-random-chars-xxxxxxxxxxxx"

# ── Placement ───────────────────────────────────────────────────────────────
WEDDING_TABLE_COUNT=20
WEDDING_TABLE_CAPACITY=10

# ── URL publique (aperçu WhatsApp / Open Graph) ─────────────────────────────
# Facultatif sur Vercel (VERCEL_PROJECT_PRODUCTION_URL est utilisé par défaut).
# NEXT_PUBLIC_SITE_URL="https://mariage.example.com"
